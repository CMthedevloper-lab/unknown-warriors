initGame();

function drawHUD() {
  // P1 Bars
  ctx.fillStyle = '#333'; ctx.fillRect(20, 20, 300, 20);
  ctx.fillStyle = '#ef4444'; ctx.fillRect(20, 20, (p1.hp / 100) * 300, 20);
  ctx.fillStyle = '#3b82f6'; ctx.fillRect(20, 45, (p1.energy / 100) * 200, 8);

  // P2 Bars
  ctx.fillStyle = '#333'; ctx.fillRect(480, 20, 300, 20);
  ctx.fillStyle = '#ef4444'; ctx.fillRect(480 + (300 - (p2.hp / 100) * 300), 20, (p2.hp / 100) * 300, 20);
  ctx.fillStyle = '#3b82f6'; ctx.fillRect(580 + (200 - (p2.energy / 100) * 200), 45, (p2.energy / 100) * 200, 8);

  // Win State
  if (p1.hp <= 0 || p2.hp <= 0) {
    ctx.fillStyle = '#fff';
    ctx.font = 'bold 36px sans-serif';
    ctx.textAlign = 'center';
    const winner = p1.hp <= 0 && p2.hp <= 0 ? 'DRAW' : (p1.hp > 0 ? 'PLAYER 1 WINS' : 'PLAYER 2 WINS');
    ctx.fillText(winner, canvas.width / 2, canvas.height / 2);
    ctx.textAlign = 'left';
  }
}

function gameLoop() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  // Floor
  ctx.fillStyle = '#2e2e38';
  ctx.fillRect(0, FLOOR, canvas.width, canvas.height - FLOOR);

  p1.update(p2);
  p2.update(p1);

  p1.draw();
  p2.draw();
  drawHUD();

  requestAnimationFrame(gameLoop);
}

gameLoop();
</script>
