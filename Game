<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>2D Arena Fighter</title>
<style>
  body { margin: 0; background: #121212; color: #fff; font-family: sans-serif; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; }
  canvas { border: 2px solid #444; background: #1e1e24; }
  .controls { display: flex; gap: 20px; margin-top: 10px; font-size: 13px; color: #ccc; }
  select, button { padding: 5px 10px; background: #333; color: #fff; border: 1px solid #555; cursor: pointer; }
</style>
</head>
<body>

<div style="margin-bottom: 10px; display: flex; gap: 15px; align-items: center;">
  <label>P1: 
    <select id="p1Select">
      <option value="ninja">Ninja</option>
      <option value="hypnotist">Hypnotist</option>
      <option value="yoga">Yoga Master</option>
    </select>
  </label>
  <button id="startBtn">Start / Reset Match</button>
  <label>P2: 
    <select id="p2Select">
      <option value="hypnotist">Hypnotist</option>
      <option value="ninja">Ninja</option>
      <option value="yoga">Yoga Master</option>
    </select>
  </label>
</div>

<canvas id="game" width="800" height="400"></canvas>

<div class="controls">
  <div><strong>Player 1:</strong> A/D Move | W Jump | F Attack | G Special 1 | H Special 2</div>
  <div><strong>Player 2:</strong> Arrows Move/Jump | K Attack | L Special 1 | ; Special 2</div>
</div>

<script>
const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');
const GRAVITY = 0.6;
const FLOOR = 350;

// Web Audio API Synthesizer for SFX
const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
function playSound(freq, type, duration) {
  if (audioCtx.state === 'suspended') audioCtx.resume();
  const osc = audioCtx.createOscillator();
  const gain = audioCtx.createGain();
  osc.type = type;
  osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
  gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
  gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
  osc.connect(gain);
  gain.connect(audioCtx.destination);
  osc.start();
  osc.stop(audioCtx.currentTime + duration);
}

const keys = {};
window.addEventListener('keydown', e => keys[e.code] = true);
window.addEventListener('keyup', e => keys[e.code] = false);

class Fighter {
  constructor(x, color, type, controls, facing) {
    this.x = x;
    this.y = FLOOR - 80;
    this.w = 40;
    this.h = 80;
    this.vx = 0;
    this.vy = 0;
    this.color = color;
    this.type = type;
    this.controls = controls;
    this.facing = facing; // 1 = right, -1 = left
    
    this.hp = 100;
    this.energy = 100;
    this.speed = type === 'ninja' ? 6 : 4;
    this.atkPower = type === 'yoga' ? 14 : 10;
    
    // States & Timers
    this.attackCooldown = 0;
    this.attackBox = null;
    this.stunTimer = 0;     // Hypnotized state
    this.invisibleTimer = 0; // Ninja smoke bomb
    this.meditating = false; // Yoga master heal/charge
    this.projectiles = [];
  }

  update(opponent) {
    if (this.hp <= 0) return;

    // Energy regen & timers
    if (this.energy < 100 && !this.meditating) this.energy += 0.15;
    if (this.attackCooldown > 0) this.attackCooldown--;
    if (this.invisibleTimer > 0) this.invisibleTimer--;

    // Hypnotized status overrides input
    if (this.stunTimer > 0) {
      this.stunTimer--;
      this.vx = 0;
      this.meditating = false;
      this.applyPhysics();
      return;
    }

    // Meditation mechanic (Yoga Master)
    if (this.type === 'yoga' && keys[this.controls.sp2] && this.y + this.h >= FLOOR) {
      this.meditating = true;
      this.vx = 0;
      if (this.hp < 100) this.hp += 0.12;
      if (this.energy < 100) this.energy += 0.5;
      if (Math.random() < 0.1) playSound(520, 'sine', 0.1);
      this.applyPhysics();
      return;
    } else {
      this.meditating = false;
    }

    // Horizontal Movement
    this.vx = 0;
    if (keys[this.controls.left]) { this.vx = -this.speed; this.facing = -1; }
    if (keys[this.controls.right]) { this.vx = this.speed; this.facing = 1; }

    // Jump
    if (keys[this.controls.up] && this.y + this.h >= FLOOR) {
      this.vy = -13;
      playSound(250, 'triangle', 0.15);
    }

    // Basic Melee Attack
    if (keys[this.controls.atk] && this.attackCooldown === 0) {
      this.attackCooldown = 25;
      this.attackBox = {
        x: this.facing === 1 ? this.x + this.w : this.x - 45,
        y: this.y + 20,
        w: 45,
        h: 20,
        active: 8
      };
      playSound(150, 'square', 0.1);
    }

    // Special 1
    if (keys[this.controls.sp1] && this.attackCooldown === 0 && this.energy >= 25) {
      this.energy -= 25;
      this.attackCooldown = 35;
      if (this.type === 'ninja') {
        // Kunai throw
        this.projectiles.push({ x: this.x + this.w/2, y: this.y + 30, vx: this.facing * 11, w: 15, h: 5, type: 'kunai' });
        playSound(600, 'sawtooth', 0.1);
      } else if (this.type === 'hypnotist') {
        // Hypnosis Wave (bypasses smoke bomb invisibility, stuns target)
        this.projectiles.push({ x: this.x + this.w/2, y: this.y + 20, vx: this.facing * 7, w: 20, h: 40, type: 'hypno' });
        playSound(380, 'sine', 0.3);
      } else if (this.type === 'yoga') {
        // Chakra Blast
        this.projectiles.push({ x: this.x + this.w/2, y: this.y + 25, vx: this.facing * 8, w: 25, h: 25, type: 'chakra' });
        playSound(300, 'triangle', 0.2);
      }
    }

    // Special 2
    if (keys[this.controls.sp2] && this.attackCooldown === 0 && this.energy >= 30) {
      if (this.type === 'ninja') {
        // Dash + Smoke Bomb (grants brief invisibility/evasion)
        this.energy -= 30;
        this.attackCooldown = 40;
        this.x += this.facing * 110;
        this.invisibleTimer = 75;
        playSound(120, 'noise' in audioCtx ? 'sine' : 'sawtooth', 0.25);
      } else if (this.type === 'hypnotist') {
        // Mesmerize Blink (teleport behind opponent)
        this.energy -= 30;
        this.attackCooldown = 45;
        this.x = opponent.x - (opponent.facing * 50);
        this.facing = opponent.facing;
        playSound(450, 'sine', 0.2);
      }
    }

    this.applyPhysics();
    this.handleCombat(opponent);
  }

  applyPhysics() {
    this.vy += GRAVITY;
    this.x += this.vx;
    this.y += this.vy;

    if (this.y + this.h >= FLOOR) {
      this.y = FLOOR - this.h;
      this.vy = 0;
    }
    this.x = Math.max(0, Math.min(canvas.width - this.w, this.x));
  }

  handleCombat(opponent) {
    // Melee hit check
    if (this.attackBox && this.attackBox.active > 0) {
      this.attackBox.active--;
      if (this.checkCollision(this.attackBox, opponent) && opponent.invisibleTimer === 0) {
        opponent.hp = Math.max(0, opponent.hp - this.atkPower);
        opponent.x += this.facing * 15;
        this.attackBox.active = 0;
        playSound(100, 'square', 0.15);
      }
    } else {
      this.attackBox = null;
    }

    // Projectile updates & collisions
    for (let i = this.projectiles.length - 1; i >= 0; i--) {
      let p = this.projectiles[i];
      p.x += p.vx;

      if (this.checkCollision(p, opponent)) {
        if (p.type === 'hypno') {
          // Hypnosis penetrates Ninja's smoke cover
          opponent.stunTimer = 90;
          opponent.invisibleTimer = 0;
          opponent.hp = Math.max(0, opponent.hp - 5);
          playSound(220, 'sine', 0.4);
          this.projectiles.splice(i, 1);
          continue;
        } else if (opponent.invisibleTimer === 0) {
          opponent.hp = Math.max(0, opponent.hp - (p.type === 'chakra' ? 15 : 8));
          playSound(110, 'sawtooth', 0.15);
          this.projectiles.splice(i, 1);
          continue;
        }
      }

      if (p.x < 0 || p.x > canvas.width) this.projectiles.splice(i, 1);
    }
  }

  checkCollision(rect1, rect2) {
    return rect1.x < rect2.x + rect2.w &&
           rect1.x + rect1.w > rect2.x &&
           rect1.y < rect2.y + rect2.h &&
           rect1.y + rect1.h > rect2.y;
  }

  draw() {
    ctx.save();
    if (this.invisibleTimer > 0) ctx.globalAlpha = 0.25;

    // Fighter Body
    ctx.fillStyle = this.stunTimer > 0 ? '#d946ef' : this.color;
    ctx.fillRect(this.x, this.y, this.w, this.h);

    // Direction Indicator (Eye/Headband)
    ctx.fillStyle = '#fff';
    ctx.fillRect(this.facing === 1 ? this.x + 25 : this.x + 5, this.y + 12, 10, 6);

    // Status Auras
    if (this.meditating) {
      ctx.strokeStyle = '#4ade80';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.arc(this.x + this.w/2, this.y + this.h/2, 50, 0, Math.PI * 2);
      ctx.stroke();
    }
    if (this.stunTimer > 0) {
      ctx.fillStyle = '#f0abfc';
      ctx.font = '12px sans-serif';
      ctx.fillText('HYPNOTIZED', this.x - 15, this.y - 10);
    }
    ctx.restore();

    // Melee Hitbox
    if (this.attackBox && this.attackBox.active > 0) {
      ctx.fillStyle = 'rgba(255, 255, 255, 0.6)';
      ctx.fillRect(this.attackBox.x, this.attackBox.y, this.attackBox.w, this.attackBox.h);
    }

    // Projectiles
    this.projectiles.forEach(p => {
      ctx.fillStyle = p.type === 'hypno' ? '#c084fc' : (p.type === 'chakra' ? '#38bdf8' : '#e2e8f0');
      ctx.fillRect(p.x, p.y, p.w, p.h);
    });
  }
}

let p1, p2;
const colors = { ninja: '#ef4444', hypnotist: '#a855f7', yoga: '#22c55e' };

function initGame() {
  const t1 = document.getElementById('p1Select').value;
  const t2 = document.getElementById('p2Select').value;
  p1 = new Fighter(150, colors[t1], t1, { left: 'KeyA', right: 'KeyD', up: 'KeyW', atk: 'KeyF', sp1: 'KeyG', sp2: 'KeyH' }, 1);
  p2 = new Fighter(610, colors[t2], t2, { left: 'ArrowLeft', right: 'ArrowRight', up: 'ArrowUp', atk: 'KeyK', sp1: 'KeyL', sp2: 'Semicolon' }, -1);
}

document.getElementById('startBtn').addEventListener('click', initGame);
initGame();

function drawHUD() {
  // P1 Bars
  ctx.fillStyle = '#333'; ctx.fillRect(20, 20, 300, 20);
  ctx.fillStyle = '#ef4444'; ctx.fillRect(20, 20, (p1.hp / 100) * 300, 20);
  ctx.fillStyle = '#3b82f6'; ctx.fillRect(20, 45, (p1.energy / 100) * 200, 8);

  // P2 Bars
  ctx.fillStyle = '#333'; ctx.fillRect(480, 20, 300, 20);
  ctx.fillStyle = '#ef4444'; ctx.fillRect(480 + (300 - (p2.hp / 100) * 300), 20, (p2.hp / 100) * 300, 20);
  ctx.fillStyle = '#3b82f6'; ctx.fillRect(580 + (200 - (p2.energy / 100) * 200), 45, (p2.energy / 100) * 200, 8);

  // Win State
  if (p1.hp <= 0 || p2.hp <= 0) {
    ctx.fillStyle = '#fff';
    ctx.font = 'bold 36px sans-serif';
    ctx.textAlign = 'center';
    const winner = p1.hp <= 0 && p2.hp <= 0 ? 'DRAW' : (p1.hp > 0 ? 'PLAYER 1 WINS' : 'PLAYER 2 WINS');
    ctx.fillText(winner, canvas.width / 2, canvas.height / 2);
    ctx.textAlign = 'left';
  }
}

function gameLoop() {
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  // Floor
  ctx.fillStyle = '#2e2e38';
  ctx.fillRect(0, FLOOR, canvas.width, canvas.height - FLOOR);

  p1.update(p2);
  p2.update(p1);

  p1.draw();
  p2.draw();
  drawHUD();

  requestAnimationFrame(gameLoop);
}

gameLoop();
</script>
</body>
</html>
